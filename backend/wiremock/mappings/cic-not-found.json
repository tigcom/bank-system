{
  "request": {
    "method": "POST",
    "urlPath": "/api/cic/check",
    "headers": {
      "Content-Type": {
        "equalTo": "application/json",
        "equalTo": "Mock-API-Key"

      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.idNumber != '123456789000' && @.idNumber != '010102020303')]"
      }
    ]
  },
  "response": {
    "status": 404,
    "bodyFileName": "cic-response-notfound.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}