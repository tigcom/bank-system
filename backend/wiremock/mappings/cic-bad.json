{
  "request": {
    "method": "POST",
    "urlPath": "/api/cic/check",
    "headers": {
      "Content-Type": {
        "equalTo": "application/json"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.idNumber == '987654321')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "bodyFileName": "cic-response-bad.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}