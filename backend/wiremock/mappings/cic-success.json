{
  "request": {
    "method": "POST",
    "urlPath": "/api/cic/check",
    "headers": {
      "Content-Type": {
        "equalTo": "application/json",
        "equalTo": "Mock-API-Key"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.idNumber == '123456789000')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "bodyFileName": "cic-response-success.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}