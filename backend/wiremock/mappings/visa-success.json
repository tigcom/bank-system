{
  "request": {
    "method": "POST",
    "urlPath": "/api/visa/registration",
    "headers": {
      "Content-Type": {
        "equalTo": "application/json",
        "equalTo": "Mock-API-Key"

      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.cardType == 'VISA')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "bodyFileName": "visa-response-success.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}