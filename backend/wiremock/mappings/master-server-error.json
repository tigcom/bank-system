{
  "request": {
    "method": "POST",
    "urlPath": "/api/master/registration",
    "headers": {
      "Content-Type": {
        "equalTo": "application/json",
        "equalTo": "Mock-API-Key"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.cardType == 'MASTER')]"
      }
    ]
  },
  "response": {
    "status": 500,
    "bodyFileName": "master-error-response.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}