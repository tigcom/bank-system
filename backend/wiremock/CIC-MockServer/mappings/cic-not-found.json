{
  "request": {
    "method": "POST",
    "urlPath": "/api/cic/check",
    "headers": {
      "Content-Type": {"equalTo": "application/json"},
      "Mock-API-Key": {"equalTo": "ApiKey abc123xyz"}
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.idNumber != '123456789000' && @.idNumber != '010102020303'&& @.idNumber != '090908080707')]"
      }
    ]
  },
  "response": {
    "status": 404,
    "bodyFileName": "cic-response-notfound.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}