{
  "request": {
    "method": "POST",
    "urlPath": "/api/openingbanking/transactions",
    "headers": {
      "Content-Type": { "equalTo": "application/json" },
      "Mock-API-Key":     { "equalTo": "ApiKey abc123xyz" }
    },
    "bodyPatterns": [
      { "matchesJsonPath": "$[?(@.accountNumber == '2002002002')]" }
    ]
  },
  "response": {
    "status": 200,
    "bodyFileName": "transactions-without-salary.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
