{
  "request": {
    "method": "POST",
    "urlPath": "/api/visa/registration",
    "headers": {
      "Content-Type": {"equalTo": "application/json"},
      "Mock-API-Key": {"equalTo": "ApiKey abc123xyz"}
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.cardType == 'VISA')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "bodyFileName": "visa-response-success.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}