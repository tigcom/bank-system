            CAST(@grp := IF(status = 'LATE', @grp + 1, 0) AS SIGNED) AS grp  
        FROM
            (SELECT
                repayment_id,
                status,
                due_date 
            FROM
                repayment 
            WHERE
                loan_id = 84 
            ORDER BY
                due_date ASC) t1  
        CROSS JOIN
            (SELECT
                @grp := 0) var_init) t2 
    WHERE
        due_date < (
            SELECT
                due_date 
            FROM
                repayment 
            WHERE
                repayment_id = ?
        ) 
    ORDER BY
        due_date DESC 
    LIMIT
        1
